# ===== Make My Space — production settings =====
# Copy to .env on the server (never commit .env). Generate secrets with:  openssl rand -hex 32

# --- Server ---
DOMAIN=erp.makemyspace.in               # your sub-domain; point its DNS A record to the VPS IP first
NODE_ENV=production
POSTGRES_PASSWORD=                      # openssl rand -hex 24
JWT_SECRET=                             # openssl rand -hex 32
JWT_REFRESH_SECRET=                     # openssl rand -hex 32 (different from above)
TZ_BUSINESS=Asia/Kolkata
LOG_LEVEL=info

# --- First login ---
ADMIN_PHONE=+91XXXXXXXXXX               # owner's WhatsApp number; becomes the first admin on an empty database
ADMIN_NAME=Owner
SEED_DEMO=false                         # true only on a trial server: loads sample leads/projects
DEMO_MODE=false                         # true shows OTP on screen. NEVER true in production (server refuses to start)

# --- Login codes ---
OTP_LENGTH=4
OTP_TTL_MIN=5

# --- File storage (site photos, drawings, sign-off photos) ---
STORAGE_DRIVER=local                    # local = disk volume on the VPS; s3 = any S3-compatible bucket; db = inside PostgreSQL (small setups / hosts with a temporary disk)
MAX_UPLOAD_MB=25
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com   # or Cloudflare R2 / DigitalOcean Spaces / Hostinger object storage endpoint
# S3_REGION=ap-south-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Meta app (developers.facebook.com → your app → Settings → Basic) ---
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=                        # used to verify every webhook signature (X-Hub-Signature-256)

# --- WhatsApp Cloud API (app → WhatsApp → API setup) ---
WHATSAPP_WABA_ID=                       # WhatsApp Business Account ID
WHATSAPP_PHONE_NUMBER_ID=               # the ID of the sending number (not the number itself)
WHATSAPP_ACCESS_TOKEN=                  # PERMANENT System User token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_VERIFY_TOKEN=                  # any random string; paste the same into the webhook settings
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_FORWARD_URL=                   # optional: an existing bot that should keep receiving messages (the ERP relays every webhook to it)
# Leave WHATSAPP_ACCESS_TOKEN empty to run in "simulated" mode (messages logged, nothing sent).

# --- Meta Lead Ads (Facebook / Instagram lead forms) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=                 # long-lived Page token (System User) with leads_retrieval, pages_manage_metadata, pages_show_list, pages_read_engagement, ads_management
META_LEADS_VERIFY_TOKEN=                # any random string; paste the same into the Page webhook settings

# --- Background work (leave on) ---
SCHEDULER_ENABLED=true                  # WhatsApp reminders 09:00/09:30/10:00/19:00 IST, CRM follow-ups, lead polling
WORKER_ENABLED=true                     # sends queued WhatsApp messages with retries
